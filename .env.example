# =============================================================================
# Mẫu env của CONTAINER APP — CHỈ giá trị giả. Bản thật: /home/deploy_dherp/app/.env (chmod 600).
# Biến của migrate/seed (owner DB, mật khẩu admin khởi tạo) KHÔNG đặt ở đây → xem .env.migrate.example.
# Đủ mọi biến app đọc (grep "process.env." trong src/). KHÔNG commit file .env thật.
# =============================================================================
NODE_ENV=production

# --- Database: role app_rw (không UPDATE/DELETE/TRUNCATE được audit_log) ---
# host = TÊN CONTAINER postgres (cùng network pgnet), KHÔNG phải localhost.
# Mật khẩu chứa @ : / # ? % phải percent-encode (@→%40 :→%3A /→%2F #→%23 ?→%3F %→%25);
# tốt nhất sinh mật khẩu không có ký tự đặc biệt: openssl rand -base64 24 | tr -d '/+=@:#?%'
DATABASE_URL=postgresql://app_rw:CHANGE_ME@postgres_dherp:5432/dherp_db

# --- next-auth v4 ---
# AUTH_SECRET: openssl rand -base64 32 (code đọc ĐÚNG tên này: secret: process.env.AUTH_SECRET)
AUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32
# URL công khai thật (https). Thiếu → "There is a problem with the server configuration".
NEXTAUTH_URL=https://dherp.sheetapp.store

# --- Tuỳ chọn ---
# "off" tắt worker tính lại giá vốn chạy nền (chỉ dùng cho test). Production: để trống/không đặt.
RECOMPUTE_WORKER=
