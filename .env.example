# =============================================================================
# Mẫu biến môi trường — CHỈ giá trị giả. Bản thật trên VPS: /home/deploy_dherp/app/.env (chmod 600).
# Đủ mọi biến code đọc (grep "process.env." trong src/ và prisma/). KHÔNG commit file .env thật.
# =============================================================================
NODE_ENV=production

# --- Database ---
# host = TÊN CONTAINER postgres (cùng network pgnet), KHÔNG phải localhost.
# Mật khẩu chứa @ : / # ? % phải percent-encode (@→%40 :→%3A /→%2F #→%23 ?→%3F %→%25);
# tốt nhất sinh mật khẩu không có ký tự đặc biệt: openssl rand -base64 24 | tr -d '/+=@:#?%'
# App chạy bằng role app_rw (không UPDATE/DELETE/TRUNCATE được audit_log):
DATABASE_URL=postgresql://app_rw:CHANGE_ME@postgres_dherp:5432/dherp_db
# Migrator (prisma migrate deploy) chạy bằng owner (tạo bảng/trigger/GRANT):
MIGRATE_DATABASE_URL=postgresql://dherp_user:CHANGE_ME@postgres_dherp:5432/dherp_db

# --- next-auth v4 ---
# AUTH_SECRET: openssl rand -base64 32 (code đọc ĐÚNG tên này: secret: process.env.AUTH_SECRET)
AUTH_SECRET=CHANGE_ME_run_openssl_rand_base64_32
# URL công khai thật (https). Thiếu → "There is a problem with the server configuration".
NEXTAUTH_URL=https://dherp.sheetapp.store

# --- Khởi tạo lần đầu (seed): tạo tài khoản 'admin' vai trò Giám đốc nếu bảng users trống ---
# Bỏ trống → không tạo. Lần đăng nhập đầu hệ thống bắt đổi mật khẩu.
# XOÁ dòng này khỏi .env thật ngay sau lần đăng nhập đầu (xem docs/infra/RUNBOOK.md).
BOOTSTRAP_ADMIN_PASSWORD=

# --- Tuỳ chọn ---
# "off" tắt worker tính lại giá vốn chạy nền (chỉ dùng cho test). Production: để trống/không đặt.
RECOMPUTE_WORKER=
