// GĐ1c (plan 04) — bán hàng. Xuất kho lúc XÁC NHẬN đơn (D-25); công nợ ghi khi GIAO (D-26).
// Mọi số tiền là tổng theo DÒNG (không phải đơn giá) trừ `salePrice` là đơn giá theo đơn vị của dòng.

enum DeliveryStatus {
  NEW
  WAITING_STOCK
  READY
  LOADED
  DELIVERING
  DELIVERED
  PARTIAL
  FAILED

  @@map("delivery_status")
}

enum PaymentStatus {
  UNPAID
  DEPOSITED
  PARTIAL
  PAID
  DEBT
  PROMISED
  OVERPAID

  @@map("payment_status")
}

/// Hai trục trạng thái ĐỘC LẬP (spec 6.1). NEW/WAITING_STOCK/READY được suy ra khi đọc từ cờ treo của dòng.
model SaleOrder {
  id                   Int            @id @default(autoincrement())
  periodId             Int
  code                 String         @unique
  partnerId            Int
  deliveryStatus       DeliveryStatus @default(NEW)
  paymentStatus        PaymentStatus  @default(UNPAID)
  /// Đơn nháp (từ báo giá): CHƯA xuất kho, chưa công nợ. Xác nhận ⇒ xuất kho FIFO (D-25). Chỉ đơn nháp mới xoá hẳn được (34c).
  isDraft              Boolean        @default(false)
  /// Người bán phụ trách đơn (mặc định = người lập). Chỉ để hiển thị/báo cáo, không ảnh hưởng quyền.
  salesUserId          Int?
  /// Kho xuất ghi trên đơn (thông tin; sổ kho FIFO hiện chỉ có một kho logic).
  warehouseId          Int?
  /// Hình thức thanh toán dự kiến — KHÔNG sinh phiếu thu; trạng thái thanh toán vẫn theo phiếu thu/công nợ.
  paymentMethod        SalePaymentMethod @default(NONE)
  /// Khách lẻ (đơn gắn khách chung KHL): tên/SĐT khách ghi trên đơn.
  walkInName           String?
  walkInPhone          String?
  /// Phí vận chuyển thu của khách: cộng vào tiền phải thu; ghi công nợ theo tỷ lệ giá trị hàng đã giao (cùng phiếu giao).
  shippingFee          Decimal        @default(0) @db.Decimal(18, 2)
  /// In "Nợ cũ" + "Tổng cộng" trên hóa đơn bán hàng. Tắt khi giao tới nhà người khác (khách không muốn lộ công nợ).
  printDebt            Boolean        @default(true)
  /// (Cũ) làm tròn LÊN nghìn đồng thành tiền từng dòng; đơn mới luôn false, chỉ đơn lập trước 26/10/2026 còn true. Xem roundTotal.
  roundAmounts         Boolean        @default(true)
  /// Làm tròn LÊN nghìn đồng ở mức TỔNG tiền hàng (Σ thành tiền dòng, chưa gồm phí ship); thành tiền dòng = SL × giá, không làm tròn.
  roundTotal           Boolean        @default(false)
  /// Địa chỉ giao hàng riêng của đơn (mặc định điền từ khách khi lập, sửa được). null = chưa nhập.
  shipAddress          String?
  /// Chiết khấu cả đơn do người dùng nhập; đã được PHÂN BỔ vào `discountNow` của từng dòng (xem `discountOrder`).
  orderDiscount        Decimal        @default(0) @db.Decimal(18, 2)
  /// Thời điểm chứng từ (docTimestamp) — cũng là `at` của mọi dòng sổ kho của đơn.
  orderDate            DateTime
  expectedDeliveryDate DateTime       @db.Date
  originalDeliveryDate DateTime       @db.Date
  note                 String?
  isCancelled          Boolean        @default(false)
  cancelledAt          DateTime?
  cancelledBy          Int?
  cancelReason         String?
  createdBy            Int
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  period       Period          @relation(fields: [periodId], references: [id], onDelete: Restrict)
  partner      Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  salesUser    User?           @relation("SaleOrderSalesUser", fields: [salesUserId], references: [id], onDelete: SetNull)
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  lines        SaleOrderLine[]
  deliveries   DeliveryNote[]
  quote        Quote?          @relation("QuoteConverted")
  receipts     Receipt[]
  tripStops    TripOrder[]
  goodsReturns GoodsReturn[]

  @@index([periodId, orderDate])
  @@index([partnerId, orderDate])
  @@index([expectedDeliveryDate])
  @@map("sale_orders")
}

model SaleOrderLine {
  /// Dự toán tại lúc lập/sửa dòng; không dùng để ghi sổ/FIFO.
  referenceCostSnapshot Json?
  id               Int      @id @default(autoincrement())
  orderId          Int
  productId        Int
  qty              Decimal  @db.Decimal(18, 3)
  unit             String
  factorUsed       Decimal  @db.Decimal(18, 6)
  qtyBase          Decimal  @db.Decimal(18, 3)
  /// Đơn giá theo `unit` của dòng.
  salePrice        Decimal  @db.Decimal(18, 2)
  /// Chiết khấu trừ ngay — SỐ TIỀN của cả dòng, giảm tiền phải thu.
  discountNow      Decimal  @default(0) @db.Decimal(18, 2)
  /// Chiết khấu tích lũy trả sau — SỐ TIỀN của cả dòng, KHÔNG giảm tiền phải thu (D-27).
  discountAccum    Decimal  @default(0) @db.Decimal(18, 2)
  /// Phần chiết khấu CẢ ĐƠN đã phân bổ vào dòng này (ĐÃ nằm trong `discountNow`; tách riêng để sửa đơn dựng lại ô chiết khấu của người dùng).
  discountOrder    Decimal  @default(0) @db.Decimal(18, 2)
  /// Ghi chú theo dòng hàng.
  note             String?
  /// Chủ dòng (engine) ghi lại sau mỗi lần tính; chỉ engine được sửa.
  unitCostFifo     Decimal  @default(0) @db.Decimal(18, 4)
  isProvisional    Boolean  @default(false)
  processingTypeId Int?
  /// Snapshot phiên bản BOM đã dùng (D-20) — đơn cũ không đổi khi BOM đổi.
  bomVersionId     Int?
  /// Tỷ lệ trừ kho của kiểu gia công đã dùng lúc lập dòng (snapshot): ngoài NVL trong định mức còn trừ CHÍNH mã bán × tỷ lệ này. NULL = không trừ thêm (đơn cũ).
  mainStockRatio   Decimal? @db.Decimal(18, 4)
  /// STOCK: issue this product; BOM: issue snapshotted components; LEGACY: old draft behavior.
  issueMode        String @default("LEGACY")
  at               DateTime
  createdAt        DateTime @default(now())

  order          SaleOrder         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  processingType ProcessingType?   @relation(fields: [processingTypeId], references: [id], onDelete: Restrict)
  bomVersion     BomVersion?       @relation(fields: [bomVersionId], references: [id], onDelete: Restrict)
  issues         SaleLineIssue[]
  deliveryLines  DeliveryLine[]
  returnLines    GoodsReturnLine[]
  discountRows   DiscountLedger[]

  @@index([orderId])
  @@index([productId])
  @@map("sale_order_lines")
}

/// Mỗi mã hàng thực sự bị xuất kho cho một dòng bán (D-24): dòng thường = chính mã bán; dòng có BOM = từng NVL.
/// `seq` lưu cùng dòng như `at` (engine-fifo §3) để sửa/khôi phục giữ đúng vị trí trong chuỗi FIFO.
model SaleLineIssue {
  id          Int     @id @default(autoincrement())
  orderLineId Int
  productId   Int
  qtyBase     Decimal @db.Decimal(18, 3)
  seq         BigInt?

  orderLine SaleOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderLineId, productId])
  @@index([productId])
  @@map("sale_line_issues")
}

/// Phiếu giao nhiều lần (mục 37). Chỉ ghi nhận SL đã giao + công nợ; KHÔNG xuất kho lần hai (D-25).
model DeliveryNote {
  id          Int       @id @default(autoincrement())
  periodId    Int
  code        String    @unique
  orderId     Int
  at          DateTime
  note        String?
  isCancelled Boolean   @default(false)
  cancelledAt DateTime?
  cancelledBy Int?
  createdBy   Int
  createdAt   DateTime  @default(now())

  period   Period         @relation(fields: [periodId], references: [id], onDelete: Restrict)
  order    SaleOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines    DeliveryLine[]
  tripStop TripOrder?

  @@index([orderId])
  @@index([periodId, at])
  @@map("delivery_notes")
}

model DeliveryLine {
  id             Int     @id @default(autoincrement())
  deliveryNoteId Int
  orderLineId    Int
  /// Theo đơn vị (`unit`) của dòng bán.
  qty            Decimal @db.Decimal(18, 3)

  deliveryNote DeliveryNote  @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  orderLine    SaleOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@index([deliveryNoteId])
  @@index([orderLineId])
  @@map("delivery_lines")
}

// ───────── C5: báo giá, đơn nháp, tiền cọc ─────────

enum QuoteStatus {
  DRAFT
  SENT
  CONVERTED
  CANCELLED

  @@map("quote_status")
}

/// Báo giá (mục 35): KHÔNG đụng kho. Chốt → "Chuyển thành đơn" sinh ĐƠN NHÁP (cũng không đụng kho).
model Quote {
  id               Int         @id @default(autoincrement())
  periodId         Int
  code             String      @unique
  partnerId        Int
  at               DateTime
  status           QuoteStatus @default(DRAFT)
  note             String?
  convertedOrderId Int?        @unique
  createdBy        Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  period         Period      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  partner        Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  convertedOrder SaleOrder?  @relation("QuoteConverted", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  lines          QuoteLine[]

  @@index([periodId, at])
  @@index([partnerId])
  @@map("quotes")
}

model QuoteLine {
  id        Int     @id @default(autoincrement())
  quoteId   Int
  productId Int
  qty       Decimal @db.Decimal(18, 3)
  unit      String
  /// Đơn giá theo `unit`.
  salePrice Decimal @db.Decimal(18, 2)
  note      String?
  /// Kiểu gia công (tuỳ chọn) — mang sang dòng đơn khi chuyển báo giá thành đơn.
  processingTypeId Int?

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  processingType ProcessingType? @relation(fields: [processingTypeId], references: [id], onDelete: Restrict)

  @@index([quoteId])
  @@map("quote_lines")
}

enum ReceiptType {
  THU_NO
  COC
  KHAC
  BO_SUNG_QUY

  @@map("receipt_type")
}

/// Phiếu thu. C5 chỉ dùng loại COC (tiền cọc); phiếu thu/sổ quỹ đầy đủ ở plan 05-D1 (khi đó dựng `cash_ledger` từ bảng này).
/// Tiền vào là `credit` của khách trong partner_ledger ngay khi lập → khi giao (debit) số dư tự bù trừ.
model Receipt {
  id            Int              @id @default(autoincrement())
  periodId      Int
  code          String           @unique
  /// null chỉ với thu khác (KHAC) không gắn đối tác.
  partnerId     Int?
  type          ReceiptType
  /// null = cọc đã chuyển thành số dư của khách (không gắn đơn nào).
  orderId       Int?
  amount        Decimal          @db.Decimal(18, 2)
  cashAccountId Int
  at            DateTime
  note          String?
  isCancelled   Boolean          @default(false)
  cancelledAt   DateTime?
  cancelledBy   Int?
  reviewStatus  CashReviewStatus @default(PENDING_REVIEW)
  reviewedBy    Int?
  reviewedAt    DateTime?
  createdBy     Int
  createdAt     DateTime         @default(now())

  period      Period      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  partner     Partner?    @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  order       SaleOrder?  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  trip        Trip?       @relation(fields: [tripId], references: [id], onDelete: Restrict)
  tripId      Int?

  @@index([orderId])
  @@index([periodId, at])
  @@index([partnerId])
  @@index([reviewStatus])
  @@map("receipts")
}

enum ReturnKind {
  BY_ORDER
  BY_PRODUCT
  SUPPLIER

  @@map("return_kind")
}

/// Phiếu trả hàng (mã 43–48). BY_ORDER/BY_PRODUCT: khách trả → nhập kho (RETURN_IN), giảm nợ khách (partner_ledger credit).
/// SUPPLIER: trả NCC → xuất kho FIFO (RETURN_SUPPLIER), giảm nợ phải trả (partner_ledger debit). Không sửa — hủy rồi lập lại.
model GoodsReturn {
  id           Int        @id @default(autoincrement())
  periodId     Int
  code         String     @unique
  kind         ReturnKind
  partnerId    Int
  /// Chỉ BY_ORDER.
  orderId      Int?
  at           DateTime
  note         String?
  totalAmount  Decimal    @db.Decimal(18, 2)
  /// Khoản khấu trừ khi khách trả hàng (phí vận chuyển/khác): công nợ khách chỉ giảm `totalAmount − deductionAmount`.
  deductionAmount Decimal @default(0) @db.Decimal(18, 2)
  deductionNote   String?
  /// Trả về kho phần HÀNG CHƯA GIAO (hàng không giao được): chỉ nhập lại kho, không ghi công nợ/chiết khấu (công nợ chỉ ghi khi giao).
  undelivered  Boolean    @default(false)
  isCancelled  Boolean    @default(false)
  cancelledAt  DateTime?
  cancelledBy  Int?
  cancelReason String?
  createdBy    Int
  createdAt    DateTime   @default(now())

  period  Period            @relation(fields: [periodId], references: [id], onDelete: Restrict)
  partner Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  order   SaleOrder?        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines   GoodsReturnLine[]
  /// Phiếu chi hoàn tiền khách (tiền mặt/chuyển khoản) lập cùng phiếu trả.
  refunds Payment[]

  @@index([periodId, at])
  @@index([partnerId])
  @@index([orderId])
  @@map("goods_returns")
}

model GoodsReturnLine {
  id                    Int      @id @default(autoincrement())
  returnId              Int
  productId             Int
  /// Chỉ BY_ORDER: dòng bán gốc (giá vốn nhập lại theo dòng này).
  orderLineId           Int?
  qty                   Decimal  @db.Decimal(18, 3)
  unit                  String
  factorUsed            Decimal  @db.Decimal(18, 6)
  qtyBase               Decimal  @db.Decimal(18, 3)
  /// Đơn giá theo `unit`: giá trừ công nợ (khách) / giá thỏa thuận (NCC).
  unitPrice             Decimal  @db.Decimal(18, 2)
  /// Thành tiền ghi công nợ của dòng (BY_ORDER: theo tỷ lệ thành tiền dòng bán, làm tròn luỹ kế).
  amount                Decimal  @db.Decimal(18, 2)
  /// Chiết khấu tích lũy được đảo theo tỷ lệ (BY_ORDER).
  discountAccumReversed Decimal  @default(0) @db.Decimal(18, 2)
  at                    DateTime
  seq                   BigInt?
  /// Ghi chú dòng; trả theo kích thước ghi "7,1 m × 1,08 × 7 = 53,676 m²" (cùng mẫu dòng bán, xem length-expr.ts).
  note                  String?

  goodsReturn GoodsReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderLine   SaleOrderLine? @relation(fields: [orderLineId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([productId])
  @@index([orderLineId])
  @@map("goods_return_lines")
}

enum SalePaymentMethod {
  NONE
  CASH
  TRANSFER
  COD

  @@map("sale_payment_method")
}
