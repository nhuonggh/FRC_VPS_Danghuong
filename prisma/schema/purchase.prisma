enum StockAdjustmentType {
  IN_NO_SUPPLIER
  LOSS
  WRITE_OFF
  STOCKTAKE

  @@map("stock_adjustment_type")
}

/// Phiếu nhập hàng: tiền hàng và cước tách riêng theo D-13.
model Purchase {
  id            Int       @id @default(autoincrement())
  periodId      Int
  code          String    @unique
  partnerId     Int
  at            DateTime
  freightCost   Decimal   @default(0) @db.Decimal(18, 2)
  purchaseTotal Decimal   @default(0) @db.Decimal(18, 2)
  note          String?
  isCancelled   Boolean   @default(false)
  cancelledAt   DateTime?
  cancelledBy   Int?
  cancelReason  String?
  createdBy     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  period  Period         @relation(fields: [periodId], references: [id], onDelete: Restrict)
  partner Partner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  lines   PurchaseLine[]

  @@index([periodId, at])
  @@index([partnerId, at])
  @@map("purchases")
}

model PurchaseLine {
  id               Int      @id @default(autoincrement())
  purchaseId       Int
  productId        Int
  qty              Decimal  @db.Decimal(18, 3)
  unit             String
  factorUsed       Decimal  @db.Decimal(18, 6)
  qtyBase          Decimal  @db.Decimal(18, 3)
  purchasePrice    Decimal  @db.Decimal(18, 2)
  purchaseAmount   Decimal  @db.Decimal(18, 2)
  allocatedFreight Decimal  @default(0) @db.Decimal(18, 2)
  rollInfo         String?
  /// Kiểu gia công của hàng nhập (tuỳ chọn, chỉ để ghi nhận — kho/FIFO vẫn theo đơn vị gốc).
  processingTypeId Int?
  rollSearch       String   @default("")
  seq              BigInt?
  createdAt        DateTime @default(now())

  supplierOrderLineId Int?
  supplierOrderLine   SupplierOrderLine? @relation(fields: [supplierOrderLineId], references: [id], onDelete: Restrict)

  purchase       Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  processingType ProcessingType? @relation(fields: [processingTypeId], references: [id], onDelete: Restrict)

  @@index([supplierOrderLineId])
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_lines")
}

model StockAdjustment {
  id           Int                 @id @default(autoincrement())
  periodId     Int
  code         String              @unique
  type         StockAdjustmentType
  at           DateTime
  note         String?
  isCancelled  Boolean             @default(false)
  cancelledAt  DateTime?
  cancelledBy  Int?
  cancelReason String?
  createdBy    Int
  createdAt    DateTime            @default(now())

  period Period                @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines  StockAdjustmentLine[]

  @@index([periodId, at])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           Int     @id @default(autoincrement())
  adjustmentId Int
  productId    Int
  qty          Decimal @db.Decimal(18, 3)
  unitCost     Decimal @db.Decimal(18, 4)
  seq          BigInt?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([adjustmentId])
  @@index([productId])
  @@map("stock_adjustment_lines")
}

model SupplierOrder {
  id          Int                   @id @default(autoincrement())
  code        String                @unique
  partnerId   Int
  date        DateTime              @db.Date
  state       String                @default("DRAFT")
  note        String                @default("")
  attachments Json                  @default("[]")
  closeReason String?
  createdBy   Int
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  partner     Partner               @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  creator     User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  lines       SupplierOrderLine[]
  notices     SupplierOrderNotice[]

  @@index([state, date])
  @@index([createdBy, date])
  @@index([partnerId, date])
  @@map("supplier_orders")
}

model SupplierOrderLine {
  id               Int             @id @default(autoincrement())
  orderId          Int
  productId        Int
  qty              Decimal         @db.Decimal(18, 3)
  unit             String
  factor           Decimal         @db.Decimal(18, 6)
  purchasePrice    Decimal         @db.Decimal(18, 2)
  processingTypeId Int?
  processingType   ProcessingType? @relation(fields: [processingTypeId], references: [id], onDelete: Restrict)
  expectedDate     DateTime?       @db.Date
  note             String          @default("")
  order            SupplierOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  receipts         PurchaseLine[]

  @@index([orderId])
  @@index([productId])
  @@map("supplier_order_lines")
}

model SupplierOrderNotice {
  id         Int           @id @default(autoincrement())
  userId     Int
  orderId    Int
  purchaseId Int
  message    String
  readAt     DateTime?
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
  @@map("supplier_order_notices")
}
