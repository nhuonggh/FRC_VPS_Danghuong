enum ProductKind {
  HANG
  NVL
  THANH_PHAM
  PHU_KIEN

  @@map("product_kind")
}

enum CashType {
  CASH
  BANK

  @@map("cash_type")
}

model PartnerGroup {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  partners Partner[]

  @@map("partner_groups")
}

/// Nhóm hàng của sản phẩm (danh mục cấu hình: Hệ thống → Cài đặt danh mục → Nhóm hàng). Tuỳ chọn — sản phẩm có thể chưa có nhóm.
model ProductGroup {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  products Product[]

  @@map("product_groups")
}

/// Danh mục đơn vị tính (chọn nhanh ở form sản phẩm). Sản phẩm vẫn lưu tên đơn vị dạng chữ, không FK.
model Unit {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  @@map("units")
}

model Partner {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  searchText   String   @default("") // D-9: chuẩn hoá không dấu để tìm kiếm
  groupId      Int
  isCustomer   Boolean  @default(true)
  isSupplier   Boolean  @default(false)
  ownerUserId  Int? // người bán phụ trách → quyền "chỉ khách của mình"
  debtLimit    Decimal  @default(0) @db.Decimal(18, 2)
  allowCredit  Boolean  @default(false)
  phone        String?
  address      String?
  /// Mã số thuế (tuỳ chọn) — hiện ở form bán hàng/hoá đơn.
  taxCode      String?
  /// Địa chỉ giao hàng (nếu khác địa chỉ chính).
  deliveryAddress String?
  /// Bổ sung từ hộp thoại "Thêm khách hàng" ở form bán hàng (tất cả tuỳ chọn).
  email          String?
  bankAccount    String? // TK ngân hàng
  representative String? // người đại diện
  sortOrder      Int? // thứ tự hiển thị
  isExpense      Boolean  @default(false) // loại đối tác "Chi phí"
  /// Khách lẻ thân quen: hồ sơ nhẹ (tên + SĐT) tự tạo khi bán lẻ, thanh toán đủ ngay, không công nợ. Ẩn khỏi danh sách đối tác mặc định.
  isRegularRetail Boolean @default(false)
  /// SĐT chuẩn hoá (chỉ chữ số) — CHỈ điền cho khách lẻ thân quen; unique ⇒ một SĐT một hồ sơ (NULL không tranh nhau).
  phoneKey       String?  @unique
  note         String?
  isActive     Boolean  @default(true)
  mergedIntoId Int? // sau khi gộp mã (mục 65)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group               PartnerGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  owner               User?                @relation("PartnerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  mergedInto          Partner?             @relation("PartnerMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedFrom          Partner[]            @relation("PartnerMerge")
  openingDebts        OpeningDebt[]
  openingDisc         OpeningDiscount[]
  partnerLedger       PartnerLedger[]
  discountLedger      DiscountLedger[]
  supplierOrders SupplierOrder[]
  purchases           Purchase[]
  saleOrders          SaleOrder[]
  quotes              Quote[]
  receipts            Receipt[]
  payments            Payment[]
  discountSettlements DiscountSettlement[]
  goodsReturns        GoodsReturn[]
  debtAdjustments     DebtAdjustment[]
  transfersFrom       DebtTransfer[]       @relation("TransferFrom")
  transfersTo         DebtTransfer[]       @relation("TransferTo")

  @@index([groupId])
  @@index([ownerUserId])
  @@index([searchText])
  @@map("partners")
}

model Product {
  referenceCostPlans ReferenceCostPlan[] @relation("ReferenceCostTarget")
  referenceTonPlans ReferenceCostPlan[] @relation("ReferenceCostTon")
  stockLanes ProductStockLane[] @relation("LaneProduct")
  laneOf ProductStockLane[] @relation("LaneStock")
  id          Int         @id @default(autoincrement())
  code        String      @unique
  name        String
  searchText  String      @default("")
  kind        ProductKind @default(HANG)
  canSell          Boolean @default(true)
  canPurchase      Boolean @default(true)
  canUseAsMaterial Boolean @default(false)
  canProduce       Boolean @default(false)
  baseUnit    String // đơn vị gốc (thường md); sổ kho & FIFO luôn tính theo đơn vị này
  minStock    Decimal     @default(0) @db.Decimal(18, 3)
  isCoil      Boolean     @default(false) // tôn cuộn — bật để hiện ở màn Tra cứu cuộn (mã 30). TODO: confirm với khách
  isActive    Boolean     @default(true)
  recomputing Boolean     @default(false) // engine đang tính lại chuỗi nền → chặn xuất mã này
  note        String?
  imageUrl    String? // ảnh minh hoạ (https hoặc /uploads/…), hiện ở form bán hàng
  groupId     Int? // nhóm hàng (tuỳ chọn)
  purchasePrice Decimal? @db.Decimal(18, 2) // giá nhập mặc định / đơn vị gốc (tham khảo, không phải giá vốn FIFO)
  salePrice     Decimal? @db.Decimal(18, 2) // giá xuất (bán) mặc định / đơn vị gốc
  importUnit    String? // đơn vị tính nhập hiển thị (trống = đơn vị gốc)
  exportUnit    String? // đơn vị tính xuất hiển thị (trống = đơn vị gốc)
  bundleQty     Decimal? @db.Decimal(18, 3) // số cây / bó
  qtyLabel      String? // tên số lượng
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  group               ProductGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  units               ProductUnit[]
  openingStock        OpeningStock[]
  layers              CostLayer[]
  ledger              StockLedger[]
  supplierOrderLines SupplierOrderLine[]
  purchaseLines       PurchaseLine[]
  adjustmentLines     StockAdjustmentLine[]
  productionOrders    ProductionOrder[]
  productionOutputs   ProductionOutput[]
  productionMaterials ProductionMaterial[]
  stocktakeLines      StocktakeLine[]
  boms                Bom[]
  processingRatios    ProductProcessingRatio[]
  bomLines            BomLine[]
  saleLines           SaleOrderLine[]
  saleIssues          SaleLineIssue[]
  quoteLines          QuoteLine[]
  returnLines         GoodsReturnLine[]

  @@index([searchText])
  @@index([kind])
  @@index([groupId])
  @@map("products")
}

model ProductUnit {
  id        Int     @id @default(autoincrement())
  productId Int
  unit      String
  factor    Decimal @db.Decimal(18, 6) // D-12: SỐ ĐƠN VỊ NHẬP TRÊN 1 ĐƠN VỊ GỐC (kg/md). qtyBase = qty ÷ factor. Sửa được theo từng lần nhập

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unit])
  @@map("product_units")
}

model Warehouse {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  saleOrders SaleOrder[]

  @@map("warehouses")
}

model CashAccount {
  id       Int      @id @default(autoincrement())
  type     CashType
  name     String   @unique
  bankNo   String?
  isActive Boolean  @default(true)

  openingCash OpeningCash[]
  ledger      CashLedger[]
  receipts    Receipt[]
  payments    Payment[]

  @@map("cash_accounts")
}

// Danh mục nhỏ (Catalog Settings). Cùng dạng: tên + bật/tắt. isActive=false → ẩn khỏi ô chọn, dữ liệu cũ giữ nguyên.
model Vehicle {
  id       Int     @id @default(autoincrement())
  plate    String  @unique
  isActive Boolean @default(true)

  trips Trip[]

  @@map("vehicles")
}

model Driver {
  id          Int     @id @default(autoincrement())
  name        String
  isAssistant Boolean @default(false)
  isActive    Boolean @default(true)

  driverTrips    Trip[] @relation("TripDriver")
  assistantTrips Trip[] @relation("TripAssistant")

  @@map("drivers")
}

model Route {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  trips Trip[]

  @@map("routes")
}

model ExpenseType {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  expenses OperatingExpense[]

  @@map("expense_types")
}

// Kiểu gia công (tôn xốp, 1 lớp, 6 sóng, 11 sóng — mục 13). Công thức NVL nằm ở BOM (plan 03c).
enum PriceBasis {
  LENGTH
  AREA
  /// Bán/nhập theo đúng ĐVT riêng của kiểu (kg, bình, cây…): không có tỷ lệ m²/md.
  UNIT
}

model ProcessingType {
  referenceCostPlans ReferenceCostPlan[]
  stockLanes ProductStockLane[]
  id       Int     @id @default(autoincrement())
  name     String  @unique
  note     String?
  isActive Boolean @default(true)
  /// Tỷ lệ m²/md mặc định (khi sản phẩm chưa có tỷ lệ riêng ở product_processing_ratios), tỷ lệ trừ kho, ĐVT. CHECK > 0.
  ratio      Decimal? @db.Decimal(18, 4)
  stockRatio Decimal? @db.Decimal(18, 4)
  unit       String?
  /// Cách tính giá khi bán/nhập/báo giá: LENGTH = giá/md (đơn vị gốc), AREA = giá/m² (tính ra giá/md bằng tỷ lệ m²/md). Chỉ ảnh hưởng cách nhập/hiển thị; giá lưu vẫn là giá/md.
  priceBasis PriceBasis @default(LENGTH)

  boms      Bom[]
  ratios    ProductProcessingRatio[]
  saleLines SaleOrderLine[]
  supplierOrderLines SupplierOrderLine[]
  purchaseLines PurchaseLine[]
  quoteLines    QuoteLine[]

  @@map("processing_types")
}
